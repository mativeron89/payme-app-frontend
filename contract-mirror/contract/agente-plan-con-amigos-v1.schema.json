{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "payme.app.agente-plan-con-amigos/v1",
  "title": "Plan con amigos · Para vos",
  "description": "Ambas banderas apagadas por defecto. Con alguna apagada se conserva la respuesta de ruta desconocida. La ubicación se acepta sólo en el cuerpo, sin persistir. Ningún contrato de consentimiento vigente en la base C101 acredita el texto ampliado. Sin un otorgamiento verificable, el solicitante recibe 403. Un grupo inelegible se omite sin indicar el motivo.",
  "endpoints": {
    "POST /api/agente/plan-con-amigos": {
      "auth": "Cuenta autenticada, adulta y con recomendaciones otorgado bajo texto ampliado D574",
      "flags": [
        "RECOMENDACIONES_CERCA_ENABLED",
        "AGENTE_PLAN_CON_AMIGOS_ENABLED"
      ],
      "body": {
        "$ref": "#/$defs/ubicacion"
      },
      "200": {
        "$ref": "#/$defs/plan"
      }
    }
  },
  "headers": {
    "Cache-Control": "private, no-store"
  },
  "errors": {
    "400": {
      "error": "validation_error"
    },
    "403": [
      {
        "error": "account_required"
      },
      {
        "error": "permission_required",
        "purpose": "recomendaciones"
      }
    ],
    "404": {
      "error": "not_found",
      "path": "/api/agente/plan-con-amigos"
    },
    "429": {
      "error": "too_many_requests",
      "description": "Comparte los contadores por cuenta de POST /cerca."
    }
  },
  "$defs": {
    "ubicacion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lat",
        "lon"
      ],
      "properties": {
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lon": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      }
    },
    "lugar": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "nombre",
        "cocina",
        "distancia_m",
        "nivel",
        "estrellas"
      ],
      "properties": {
        "ref": {
          "type": "string"
        },
        "nombre": {
          "type": "string"
        },
        "cocina": {
          "type": [
            "string",
            "null"
          ]
        },
        "distancia_m": {
          "type": "integer",
          "minimum": 50,
          "multipleOf": 50
        },
        "nivel": {
          "enum": [
            "confirmado",
            "probable"
          ],
          "description": "Confirmado cuando cada integrante con platos encuentra una coincidencia confirmada."
        },
        "estrellas": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "promedio",
                "cuentas"
              ],
              "properties": {
                "promedio": {
                  "type": "number",
                  "minimum": 1,
                  "maximum": 5
                },
                "cuentas": {
                  "type": "integer",
                  "minimum": 3
                }
              }
            }
          ]
        }
      }
    },
    "grupo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "personas",
        "ultima_mesa",
        "lugares"
      ],
      "properties": {
        "personas": {
          "type": "integer",
          "minimum": 2
        },
        "ultima_mesa": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "restaurante",
            "fecha"
          ],
          "properties": {
            "restaurante": {
              "type": [
                "string",
                "null"
              ]
            },
            "fecha": {
              "type": "string",
              "format": "date"
            }
          }
        },
        "lugares": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/lugar"
          }
        }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "radio_m",
        "grupos",
        "atribucion"
      ],
      "properties": {
        "radio_m": {
          "enum": [
            1000,
            3000
          ]
        },
        "grupos": {
          "type": "array",
          "minItems": 0,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/grupo"
          }
        },
        "atribucion": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "textos",
            "urls"
          ],
          "properties": {
            "textos": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "urls": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
