{
  "version": 1,
  "owner": "payme-app-backend",
  "activation": "local_dark",
  "signup_gate": {
    "env": "PUBLIC_SIGNUP_ENABLED",
    "open_value": "true",
    "otherwise": "invitation_required",
    "read_at": "every_request. Lo leen por request tanto la AUTORIDAD (services/signupInvitations.autoridadDeAlta) como los DTO: routes/auth.js y routes/social-auth.js eligen schema en cada llamada (C2b). Cambiar el valor no exige un release del código; sí exige lo que la plataforma pida para cambiar una variable de entorno, y eso no está verificado contra el hosting.",
    "applies_to": ["POST /api/auth/register", "POST /api/auth/google/register"],
    "applies_to_nota": "POST /api/auth/register no está descripto en este documento —es el alta directa, del mismo dueño— y se lista porque la puerta es la misma.",
    "capability_publicada": {
      "ruta": "GET /api/config",
      "path": "features.signup.public_registration",
      "forma": "booleano vivo, acompañado de features.signup.supported",
      "absent_means": "backend anterior a C2b: se asume alta CERRADA (hay que pedir invitación)",
      "unknown_or_malformed_means": "alta CERRADA",
      "por_que": "es la forma soportada de saber si hay que pedir invitación; NO se infiere probando el alta y leyendo el 403 opaco"
    },
    "facebook": "register/start conserva invitation_token obligatorio; sigue dark hasta Meta",
    "anti_enumeration": "con el alta abierta, un email ya registrado responde el MISMO registration_not_available opaco, nunca un 409 que lo confirme. Lo que sí cambia, y es inevitable al abrir el registro: un 201 frente a un 403 distingue un email libre de uno tomado. No es una regresión del guard, es la consecuencia de abrir el alta; el consumidor no debe afirmar existencia en su copy (D-R15).",
    "anti_enumeration_residual": "quedan declarados otros dos oráculos, los dos consecuencia de reglas ratificadas y no defectos: (a) quien tiene una invitación puede confirmar a qué email está ligada, porque un email distinto da 403 y el intento fallido no consume ni la invitación ni la credencial del proveedor; (b) publicar features.signup.public_registration desambigua un 403 entre alta cerrada y email tomado. Ambos se limitan por rate limit, no por opacidad.",
    "email_verification": "ninguna en este corte; no se publica email_verified por inferencia",
    "owner_decision": "2026-09-01 · cierre del corte del viernes §2.2 · materializa el «cuando estemos listos» de D-FF-1 sin borrar la invitación"
  },
  "external_prerequisites": [
    "google_verifier_and_client_ids",
    "payme_recovery_transport",
    "meta_app_review_and_live_mode",
    "meta_exact_redirect_and_callbacks",
    "meta_data_deletion_legal_retention",
    "physical_browser_validation"
  ],
  "capability": {
    "path": "features.social_auth",
    "absent_means": "google_facebook_recovery_off_password_login_enabled",
    "unknown_or_malformed_means": "google_facebook_recovery_off_password_login_enabled",
    "shape": {
      "google_sign_in": ["enabled", "registration", "login", "linking", "web_client_id"],
      "facebook_sign_in": ["enabled", "registration", "login", "app_id", "redirect_uri"],
      "recovery_email": ["enabled", "completion_route"],
      "password_login": ["enabled"]
    }
  },
  "endpoints": {
    "google_register": {
      "method": "POST",
      "path": "/api/auth/google/register",
      "request": ["invitation_token?", "email?", "id_token", "first_name", "last_name", "birth_date?"],
      "request_notes": {
        "invitation_token": "Obligatorio con el alta cerrada (default). Con PUBLIC_SIGNUP_ENABLED=true es opcional: si llega se valida y consume; inválido = registration_not_available.",
        "email": "Declarado por el usuario, NO verificado y NO autoridad: no enlaza, no fusiona ni recupera una cuenta existente, y un email ya registrado devuelve el mismo registration_not_available opaco. SÓLO se acepta con PUBLIC_SIGNUP_ENABLED=true (con el alta cerrada el DTO es strict y lo rechaza con validation_error). Sin invitación es la ÚNICA fuente del email de la cuenta, con el mismo parser que el alta directa; con invitación manda la invitación y un email distinto es registration_not_available. Nunca el email del proveedor: en esta versión lo escribe la persona, y prellenarlo desde la credencial del proveedor sería un cambio de contrato posterior."
      },
      "success_status": 201,
      "success_shape": "session_success_shape",
      "errors": {
        "not_found": [404],
        "validation_error": [400],
        "registration_not_available": [403, 503],
        "registration_unavailable": [503],
        "too_many_auth_attempts": [429],
        "too_many_signup_attempts": [429],
        "rate_limit_unavailable": [503]
      }
    },
    "google_login": {
      "method": "POST",
      "path": "/api/auth/google/login",
      "request": ["id_token"],
      "success_status": 200,
      "success_shape": "session_success_shape",
      "errors": {
        "not_found": [404],
        "validation_error": [400],
        "social_auth_failed": [401, 503],
        "too_many_auth_attempts": [429]
      }
    },
    "google_link": {
      "method": "POST",
      "path": "/api/auth/google/link",
      "auth": "payme_bearer",
      "request": ["id_token", "current_password"],
      "success": { "linked": true, "provider": "google" },
      "errors": {
        "not_found": [404],
        "validation_error": [400],
        "auth_required": [401],
        "reauthentication_failed": [403],
        "social_auth_failed": [401, 503],
        "too_many_auth_attempts": [429]
      }
    },
    "facebook_register_start": {
      "method": "POST",
      "path": "/api/auth/facebook/register/start",
      "request": ["invitation_token", "first_name", "last_name", "birth_date?"],
      "success": ["authorization_url", "expires_at"],
      "errors": {
        "not_found": [404],
        "validation_error": [400],
        "registration_not_available": [403, 503],
        "registration_unavailable": [503],
        "too_many_auth_attempts": [429],
        "too_many_signup_attempts": [429],
        "rate_limit_unavailable": [503]
      }
    },
    "facebook_register_complete": {
      "method": "POST",
      "path": "/api/auth/facebook/register/complete",
      "request": ["state", "code"],
      "success_status": 201,
      "success_shape": "session_success_shape",
      "errors": {
        "not_found": [404],
        "validation_error": [400],
        "registration_not_available": [403, 503],
        "registration_unavailable": [503],
        "too_many_auth_attempts": [429]
      }
    },
    "facebook_login_start": {
      "method": "POST",
      "path": "/api/auth/facebook/login/start",
      "request": [],
      "success": ["authorization_url", "expires_at"],
      "errors": {
        "not_found": [404],
        "validation_error": [400],
        "social_auth_failed": [401, 503],
        "too_many_auth_attempts": [429]
      }
    },
    "facebook_login_complete": {
      "method": "POST",
      "path": "/api/auth/facebook/login/complete",
      "request": ["state", "code"],
      "success_status": 200,
      "success_shape": "session_success_shape",
      "errors": {
        "not_found": [404],
        "validation_error": [400],
        "social_auth_failed": [401, 503],
        "too_many_auth_attempts": [429]
      }
    },
    "facebook_deauthorize": {
      "method": "POST",
      "path": "/api/auth/facebook/deauthorize",
      "content_type": "application/x-www-form-urlencoded",
      "request": ["signed_request"],
      "success": { "accepted": true },
      "errors": {
        "not_found": [404],
        "validation_error": [400],
        "facebook_callback_invalid": [400]
      }
    },
    "facebook_data_deletion": {
      "method": "POST",
      "path": "/api/auth/facebook/data-deletion",
      "content_type": "application/x-www-form-urlencoded",
      "request": ["signed_request"],
      "success": ["url", "confirmation_code"],
      "status_semantics": "pending_until_quiescence_is_proven",
      "errors": {
        "not_found": [404],
        "validation_error": [400],
        "facebook_callback_invalid": [400]
      }
    },
    "facebook_data_deletion_status": {
      "method": "GET",
      "path": "/api/auth/facebook/data-deletion/status/:confirmation_code",
      "success": { "status": ["pending", "completed"] },
      "errors": { "not_found": [404] },
      "durable_without_current_meta_configuration": true
    },
    "recovery_request": {
      "method": "POST",
      "path": "/api/auth/recovery/request",
      "request": ["email"],
      "success_status": 202,
      "success": { "accepted": true },
      "errors": {
        "not_found": [404],
        "validation_error": [400],
        "too_many_auth_attempts": [429]
      }
    },
    "recovery_complete": {
      "method": "POST",
      "path": "/api/auth/recovery/complete",
      "request": ["token", "new_password"],
      "success": { "completed": true },
      "errors": {
        "validation_error": [400],
        "recovery_not_available": [403],
        "too_many_auth_attempts": [429]
      }
    }
  },
  "facebook_redirect_flow": {
    "browser_binding": "store_exact_start_state_and_purpose_in_session_storage",
    "callback_check": "compare_url_state_exactly_before_complete",
    "callback_cleanup": "remove_code_and_state_from_url_immediately",
    "state_storage": "session_storage_only_until_callback",
    "state_forbidden_in": ["database_raw", "logs", "local_storage"],
    "payme_session_tokens_in_url": false,
    "facebook_linking_in_v1": false,
    "reauthorization_after_deauthorization_in_v1": false
  },
  "recovery_delivery_flow": {
    "link_template": "{app_origin}/#/recovery?token={percent_encoded_raw_token}",
    "token_location": "fragment_query_only",
    "token_parameter": "token",
    "missing_or_duplicate_token": "invalid",
    "capture": "read_once_then_remove_from_url_immediately_before_any_network_request",
    "temporary_storage": "memory_only",
    "http_request_target_contains_token": false,
    "forbidden_storage": ["local_storage", "session_storage", "indexed_db", "logs", "analytics"],
    "completion_request": "post_token_and_new_password_in_https_body"
  },
  "session_success_shape": {
    "user": ["id", "payme_id", "email", "first_name", "last_name"],
    "access_token": "string",
    "refresh_token": "string",
    "expires_in": "integer_seconds"
  },
  "forbidden_client_fields": [
    "provider_email",
    "provider_name",
    "provider_photo",
    "provider_subject",
    "provider_access_token",
    "provider_refresh_token",
    "app_secret",
    "subject_control_secret"
  ],
  "forbidden_persistence": {
    "scope": "backend_database_logs_and_artifacts",
    "values": [
      "id_token",
      "facebook_authorization_code",
      "facebook_state_raw",
      "facebook_signed_request",
      "facebook_confirmation_code_raw",
      "provider_access_token",
      "provider_refresh_token",
      "provider_email",
      "provider_name",
      "provider_photo",
      "app_secret",
      "subject_control_secret"
    ]
  }
}
