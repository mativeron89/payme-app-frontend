# T7 — conexión al backend real local.
# Copiar a `.env.local` (que NO se versiona) para trabajar contra el backend.
#
#   cp .env.local.example .env.local
#
# Con esto el front deja de usar la demo y habla con payme-app-backend.

VITE_MOCK=0
VITE_API_URL=http://localhost:3000

# G-01 resuelto: el restaurante llega normalmente en el QR (`?r=<uuid>`) y el
# front lo valida con GET /api/restaurants/:id. Este uuid es sólo un fallback
# local cuando la URL no trae QR; el nombre siempre viene del backend.
VITE_RESTAURANT_ID=

# La clave PUBLICABLE de Stripe NO se pone acá: el front la pide a
# GET /api/config, que la sirve desde el .env del backend. La clave SECRETA
# vive únicamente en el backend.

# G-24 · modo demo (`?demo=1`): sustituye Stripe Elements por el PaymentMethod
# público de test `pm_card_visa` y saltea la captura OCR. Requiere ESTA
# capability de build; sin ella la URL no puede activarlo y el bundle real ni
# siquiera contiene el token. Encenderla SOLO para compilar un artefacto de demo
# separado, con host, acceso y datos aislados, y un entorno acreditado como
# Stripe test. Nunca en el artefacto que apunta a credenciales live.
# VITE_ALLOW_DEMO=1
