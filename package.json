{
  "name": "payme-app-frontend",
  "private": true,
  "version": "0.142.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "vitest run --reporter=default --reporter=json --outputFile=.vitest-corrida.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.e2e.json",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "build:landing": "vite build --config vite.landing.config.ts",
    "preview": "vite preview",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@stripe/stripe-js": "^9.10.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/js-yaml": "4.0.9",
    "@types/node": "24.13.3",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "js-yaml": "4.1.0",
    "typescript": "~5.6.3",
    "vite": "^5.4.8",
    "vitest": "^3.2.7"
  }
}
